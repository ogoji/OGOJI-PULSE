{
  "entities": {
    "User": {
      "collection": "users",
      "fields": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["client", "admin", "creator", "follower"] },
        "bio": { "type": "string" },
        "headline": { "type": "string" },
        "createdAt": { "type": "timestamp" }
      }
    },
    "Booking": {
      "collection": "bookings",
      "fields": {
        "userId": { "type": "string" },
        "clientName": { "type": "string" },
        "clientEmail": { "type": "string" },
        "serviceId": { "type": "string" },
        "serviceTitle": { "type": "string" },
        "tierName": { "type": "string" },
        "priceNgn": { "type": "number" },
        "priceUsd": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["palmpay", "usdt"] },
        "status": { "type": "string", "enum": ["pending_verification", "verified", "in_progress", "completed"] },
        "proofOfPaymentNote": { "type": "string" },
        "createdAt": { "type": "timestamp" }
      }
    },
    "EngagementCampaign": {
      "collection": "engagement_campaigns",
      "fields": {
        "userId": { "type": "string" },
        "authorName": { "type": "string" },
        "platform": { "type": "string", "enum": ["Instagram", "TikTok", "YouTube", "X/Twitter", "LinkedIn"] },
        "postUrl": { "type": "string" },
        "packageType": { "type": "string" },
        "targetInteractions": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "queued", "completed"] },
        "createdAt": { "type": "timestamp" }
      }
    },
    "Discussion": {
      "collection": "discussions",
      "fields": {
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorAvatar": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string" },
        "likes": { "type": "number" },
        "repliesCount": { "type": "number" },
        "createdAt": { "type": "timestamp" }
      }
    },
    "QAQuestion": {
      "collection": "qa_questions",
      "fields": {
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorAvatar": { "type": "string" },
        "questionText": { "type": "string" },
        "category": { "type": "string" },
        "upvotes": { "type": "number" },
        "status": { "type": "string", "enum": ["open", "queued_for_video", "answered"] },
        "createdAt": { "type": "timestamp" }
      }
    },
    "NewsletterSubscriber": {
      "collection": "newsletter_subscribers",
      "fields": {
        "email": { "type": "string" },
        "source": { "type": "string" },
        "interests": { "type": "array" },
        "status": { "type": "string", "enum": ["subscribed", "unsubscribed"] },
        "userId": { "type": "string" },
        "createdAt": { "type": "timestamp" }
      }
    }
  }
}
